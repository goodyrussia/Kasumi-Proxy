# ── Release-time build artifacts (produced by scripts/) ──────────
# Cores fetched/built by fetch-binaries.sh android (xray, tun2socks,
# hev-socks5-tunnel) + the kasumi-proxy daemon built by build-daemon-android.sh —
# track only the docs/licenses.
module/bin/*
!module/bin/README.md
!module/bin/licenses/
!module/bin/licenses/*

# Production webroot built by build-webroot.sh.
module/webroot/*

# Config-compat staging dir (host core + geoip/geosite staged by CI or locally).
/bin/

# ── Node / Vite ──────────────────────────────────────────────────
node_modules/
frontend/dist/
# tsc -b incremental build cache (per-package, machine-specific)
*.tsbuildinfo
coverage/
.npm/
package-lock.json

# ── Release artifacts ────────────────────────────────────────────
build/
dist/
*.zip

# ── Local build cache ────────────────────────────────────────────
.cache/

# ── Rust / Cargo ─────────────────────────────────────────────────
/target/

# ── Nix / direnv ─────────────────────────────────────────────────
.direnv/
result

# ── Tooling / editors / OS ───────────────────────────────────────
.ralph/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Local logs / scratch ─────────────────────────────────────────
*.log
*.tmp
*.swp
*.swo
*.orig
*.rej
*.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
